# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# JWT Secret - Generate a strong random secret for production
# You can generate one using: openssl rand -hex 32
JWT_SECRET=c9b8a3e7f6d5c4b3a2e1f0d9c8b7a6e5d4c3b2a1f0e9d8c7b6a5d4c3b2a1f0e9

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://username:password@postgres:5432/self_claim_db

# PostgreSQL Connection Details
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=self_claim_db
POSTGRES_USER=username
POSTGRES_PASSWORD=your_strong_password_here

# Redis Configuration
REDIS_HOST=redis

# Admin Configuration
FORCE_ADMIN_PASSWORD_CHANGE=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMeImmediately!123

# Password Validation Configuration
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Strict Rate Limiting (for sensitive endpoints like login)
STRICT_RATE_LIMIT_WINDOW_MS=900000
STRICT_RATE_LIMIT_MAX_REQUESTS=10

# Application Configuration
NODE_ENV=development
PORT=3000

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_TIMEOUT_HOURS=24

# Logging and Monitoring Configuration
LOG_LEVEL=info
APP_VERSION=1.0.0
SERVER_NAME=self-claim-link-server

# Sentry Configuration (Optional - for error tracking and performance monitoring)
# Sign up at https://sentry.io and create a new project to get these values
SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn_here

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
